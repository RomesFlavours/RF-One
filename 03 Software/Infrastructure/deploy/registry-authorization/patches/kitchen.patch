+        with op.batch_alter_table(table) as batch:
+            batch.add_column(sa.Column("override_protected", sa.Boolean(), nullable=False,
+                                       server_default=sa.false()))
+
+
+def downgrade() -> None:
+    for table in TABLES:
+        with op.batch_alter_table(table) as batch:
+            batch.drop_column("override_protected")
