<?xml version="1.0" encoding="UTF-8"?>
<!--
  RF-One · careers page on Aruba Hosting Windows (IIS) — SELECTION_ARUBA_IDENTITY_001.

  Only sections that IIS delegates to sites by default, and every entry as
  remove + add, so that an entry the server already defines never causes
  "duplicate collection entry" (HTTP 500.19). No <rewrite>: the URL Rewrite
  module is not guaranteed; index.php itself redirects HTTP to HTTPS.

  - private/ (configuration, SMTP password, shared secret, library) is never
    served: hidden segment -> 404 for anything under it;
  - no folder listing; no configuration, log, data or text file served;
  - safe headers also on the stylesheet and script.
  Sessions, counters and logs are not here at all: they live in Aruba's
  mdb-database folder, which Aruba never serves to the web.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="private" />
          <add segment="private" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".json" />
          <add fileExtension=".json" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".ini" />
          <add fileExtension=".ini" allowed="false" />
          <remove fileExtension=".txt" />
          <add fileExtension=".txt" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Robots-Tag" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
