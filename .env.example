# RF-One — environment variable template.
# Copy to `.env` and fill in real values locally. Never commit `.env` itself
# (already git-ignored) and never put real values in this file.

# --- Clover (03 Software/Clover Data Explorer, RF-One Data Store's Clover
#     connector) — required for any real Clover API access ------------------
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=

# --- RF-One Data Store database (rfone_data_store/database.py) -------------
# Optional: defaults to a local SQLite file under RF-One Data Store/data/ if
# unset. Set only to point at a different database (e.g. RDS PostgreSQL).
RFONE_DATABASE_URL=

# --- Flask session secret (03 Software/Tips, 03 Software/Selection) --------
# Optional: a random key is generated per-process if unset (sessions won't
# survive an app restart). Set explicitly for a persistent deployment.
RFONE_FLASK_SECRET_KEY=

# --- RF-One Web base URL (03 Software/Tips, rfone_web_link.py) -------------
# The address standalone Tips links to for validating a saved period
# (<base>/tips/runs/<run_id>). Not a secret. Example:
# RFONE_WEB_BASE_URL=https://rfone.example.com
# Unset: Tips shows that RF-One Web navigation is not configured.
RFONE_WEB_BASE_URL=

# --- RF-One AI client (rfone_data_store/selection/parsing/ai_client.py) ----
# Used by Selection (résumé parsing, Primary Screening AI evaluation),
# Organizational AI review, and Tips AI Rule Authoring — all reuse the same
# provider-neutral generate_json() contract, never a provider-specific one.
# RFONE_AI_PROVIDER selects the active provider: ANTHROPIC (default) or
# BEDROCK. Optional overall: without a usable provider configured, callers
# fall back to their own non-AI path (e.g. Selection's deterministic parser)
# rather than erroring.
RFONE_AI_PROVIDER=
# Required only when RFONE_AI_PROVIDER=ANTHROPIC (the default).
ANTHROPIC_API_KEY=
# Required only when RFONE_AI_PROVIDER=BEDROCK — the exact Bedrock model id
# this AWS account has access to (never guessed/hardcoded by RF-One; check
# via `aws bedrock list-foundation-models`). AWS credentials themselves are
# resolved by boto3's own standard chain (AWS_REGION below, AWS_PROFILE,
# ~/.aws/credentials, SSO, etc.), never read from this file.
RFONE_BEDROCK_MODEL_ID=

# --- InvoiceIntake Textract provider (03 Software/InvoiceIntake) -----------
# Also used by the AI client's Bedrock path (above) for region resolution.
# Optional: region for AWS Textract OCR / Bedrock; AWS credentials
# themselves are resolved by boto3's own standard chain, never read from
# this file.
AWS_REGION=

# --- InvoiceIntake Aruba mailbox acquisition (03 Software/InvoiceIntake/
#     mailbox_acquisition) — invoices@romesflavours.com, Rome's Flavours'
#     operational mailbox. Required for real mailbox acquisition; see
#     mailbox_acquisition/README.md. Never commit real values.
ARUBA_IMAP_USERNAME=
ARUBA_IMAP_PASSWORD=
# Optional — sensible defaults if unset (see mailbox_acquisition/config.py):
ARUBA_IMAP_HOST=
ARUBA_IMAP_PORT=
ARUBA_IMAP_MAILBOX=
ARUBA_IMAP_POLL_INTERVAL_SECONDS=
ARUBA_IMAP_USE_SSL=
